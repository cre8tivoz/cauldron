{
  "name": "cauldron",
  "productName": "Cauldron",
  "version": "0.0.1",
  "private": true,
  "description": "A free, open-source desktop app for designing and building real Astro websites with built-in design taste.",
  "keywords": [],
  "license": "MIT",
  "author": {
    "name": "William (Billy) Chant",
    "email": "cre8tivtuts@gmail.com"
  },
  "main": ".vite/build/main.cjs",
  "scripts": {
    "start": "electron-forge start",
    "package": "electron-forge package",
    "make": "electron-forge make",
    "lint": "oxlint && oxfmt --check",
    "lint:fix": "oxlint --fix && oxfmt --write",
    "typecheck": "tsc --noEmit",
    "smoke": "node scripts/smoke.mjs",
    "test": "node scripts/test-core.mjs && node scripts/test-agent.mjs",
    "check": "npm run typecheck && npm run lint && npm test",
    "hooks:install": "node scripts/install-hooks.mjs"
  },
  "devDependencies": {
    "@electron-forge/cli": "^8.0.1",
    "@electron-forge/maker-zip": "^8.0.1",
    "@electron-forge/plugin-auto-unpack-natives": "^8.0.1",
    "@electron-forge/plugin-fuses": "^8.0.1",
    "@electron-forge/plugin-vite": "^8.0.1",
    "@electron/fuses": "^2.1.3",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.2.1",
    "electron": "45.2.3",
    "oxfmt": "^0.77.0",
    "oxlint": "^1.92.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.6"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/cre8tivoz/cauldron.git"
  },
  "dependencies": {
    "@fontsource/source-sans-3": "^5.3.1",
    "axe-core": "^4.14.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "allowScripts": {
    "fsevents@2.3.3": true
  },
  "engines": {
    "node": ">=26.13.0",
    "npm": ">=12.2.2"
  },
  "packageManager": "npm@12.2.2"
}
